#!/usr/bin/env bash
# tmux-git-status — thin reader for the tmux status bar.
#
# Prints the cached filesystem path + git status line for the given pane,
# computed by the render daemon (tmux-status-renderd). Does NO git work: the
# six git subprocesses this script used to fork on every render — per pane,
# every status-interval — were a primary source of the status-bar fork-storm.
# They now run once per tick inside the daemon.
#
# Output format: <relative-path> : <branch> (<status>)   (path only outside a repo)
# Status indicators: dirty/clean, ↑n (ahead), ↓n (behind)
#
# Usage: tmux-git-status <pane_pid>
# Called by tmux via: #(~/.local/bin/tmux-git-status "#{pane_pid}")
#
# NOTE: the argument is now the pane PID (it was pane_current_path) so this
# reader can share the per-pane cache. On a cache miss (daemon down / cold
# start) it prints nothing rather than re-forking git.

PANE_PID="$1"
[ -z "$PANE_PID" ] && exit 0
[ -z "$HOME" ] && HOME=$(eval echo ~)

CACHE="${HOME}/.cache/tmux-status/render/pane-${PANE_PID}.env"
[ -f "$CACHE" ] || exit 0

GIT_LINE=""
# shellcheck source=/dev/null
. "$CACHE" 2>/dev/null || exit 0

[ -n "$GIT_LINE" ] && echo "$GIT_LINE"
