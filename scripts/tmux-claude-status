#!/usr/bin/env bash
# Compatibility alias for installations and live tmux configurations that still
# invoke the historical Claude-specific reader name. Sourcing preserves the
# one-reader, cache-only path without adding another process.

_READER_DIR="${BASH_SOURCE[0]%/*}"
[ "$_READER_DIR" = "${BASH_SOURCE[0]}" ] && _READER_DIR="."
# shellcheck source=scripts/tmux-agent-status
. "$_READER_DIR/tmux-agent-status"
