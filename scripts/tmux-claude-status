#!/usr/bin/env bash
# tmux-claude-status — thin reader for the tmux status bar.
#
# Prints the Claude model/effort/context line (model) or the quota/cost line
# (quota) for the given pane, by reading the per-pane cache written by the
# render daemon (tmux-status-renderd). It does NO heavy work — no process-tree
# walks, transcript parsing, quota HTTP, or git — so it cannot pile up under
# load (the cause of the historical status-bar fork-storm). All computation
# happens in the daemon; this script only sources the cache and formats.
#
# Usage: tmux-claude-status <pane_pid> [model|quota]
#   model  — line 0: model (effort) │ Ctx: bar pct%
#   quota  — line 1: quota bars │ $session / $daily
# Called by tmux via: #(~/.local/bin/tmux-claude-status "#{pane_pid}" model)

PANE_PID="$1"
LINE_MODE="${2:-model}"
[ -z "$PANE_PID" ] && exit 0
[ -z "$HOME" ] && HOME=$(eval echo ~)

CACHE="${HOME}/.cache/tmux-status/render/pane-${PANE_PID}.env"
[ -f "$CACHE" ] || exit 0

# The cache is shell-sourceable KEY=value lines written atomically by the daemon
# (MODEL, SHORT_MODEL, USED_PCT, EFFORT, HAS_THINKING, QUOTA_*, SESSION_COST,
# DAILY_COST, GIT_LINE, RENDER_TS). Pre-seed defaults so a torn/partial read or
# a non-Claude pane leaves well-defined values, then source it.
MODEL=""; SHORT_MODEL=""; USED_PCT=0; EFFORT=""; HAS_THINKING=0
QUOTA_STATUS="none"; QUOTA_5H_PCT=0; QUOTA_5H_REMAIN=""
QUOTA_7D_PCT=0; QUOTA_7D_REMAIN=""; KEY_EXPIRY_WARN=0
SESSION_COST=""; DAILY_COST=""; RENDER_TS=0
# shellcheck source=/dev/null
. "$CACHE" 2>/dev/null || exit 0

# Blank line when the pane is not running Claude (matches original behavior).
[ -z "$MODEL" ] && exit 0

# ── Model label (computed in the daemon; falls back to raw MODEL) ─
short_model="${SHORT_MODEL:-$MODEL}"

# ── Staleness marker ───────────────────────────────────────────
# If the daemon has not refreshed this pane within RENDER_MAX_STALE seconds it
# may be down (or crash-looping) — show last-known values plus a dim marker on
# the model line so the bar never goes blank or silently lies about freshness.
# "now" comes from $EPOCHSECONDS (fork-free, bash 5+); on older bash (e.g. stock
# macOS 3.2) we fall back to a single `date` call. Unlike the heavy work this
# refactor removed, `date` returns instantly regardless of system load and so
# cannot pile up. Disable entirely with RENDER_STALE_MARKER=0.
STALE_MARK=""
if [ "${RENDER_STALE_MARKER:-1}" != "0" ] && [ "${RENDER_STALE_MARKER:-1}" != "false" ]; then
    RENDER_MAX_STALE="${RENDER_MAX_STALE:-30}"
    _now="${EPOCHSECONDS:-}"
    [ -z "$_now" ] && _now=$(date +%s 2>/dev/null)
    if [ -n "$_now" ] && [ "$RENDER_TS" -gt 0 ] 2>/dev/null; then
        if [ "$(( _now - RENDER_TS ))" -gt "$RENDER_MAX_STALE" ] 2>/dev/null; then
            STALE_MARK=" #[fg=colour8]⋯"
        fi
    fi
fi

# ── Bar character + color from percentage ──────────────────────
bar_char() {
    local pct="$1"
    local chars=("_" "▂" "▃" "▄" "▅" "▆" "▇" "█")
    local colors=(34 70 106 142 178 214 208 196)
    # Non-numeric input (e.g. "X"): return error indicator
    if ! [ "$pct" -eq "$pct" ] 2>/dev/null; then
        echo "#[fg=colour196]✕"
        return
    fi
    local idx=0
    if   [ "$pct" -le 0 ]  2>/dev/null; then idx=0
    elif [ "$pct" -le 12 ] 2>/dev/null; then idx=0
    elif [ "$pct" -le 25 ] 2>/dev/null; then idx=1
    elif [ "$pct" -le 37 ] 2>/dev/null; then idx=2
    elif [ "$pct" -le 50 ] 2>/dev/null; then idx=3
    elif [ "$pct" -le 62 ] 2>/dev/null; then idx=4
    elif [ "$pct" -le 75 ] 2>/dev/null; then idx=5
    elif [ "$pct" -le 87 ] 2>/dev/null; then idx=6
    else idx=7
    fi
    echo "#[fg=colour${colors[$idx]}]${chars[$idx]}"
}

# ── Segment colors ─────────────────────────────────────────────
# Pastel palette for each segment; bar chars retain their own percentage colors.
C_MODEL="colour117"   # soft sky blue
C_CTX="colour150"     # sage green
C_5H="colour223"      # light peach/orange
C_7D="colour186"      # soft wheat
C_COST="colour183"    # light lavender

# ── Output (mode-dependent) ───────────────────────────────────
if [ "$LINE_MODE" = "model" ]; then
    # Line 0: Model (effort) │ Ctx: bar pct%
    CTX_BAR=$(bar_char "$USED_PCT")

    EFFORT_DISPLAY="$EFFORT"
    [ "${HAS_THINKING:-0}" = "1" ] && [ "$EFFORT" = "auto" ] && EFFORT_DISPLAY="auto+"

    printf " #[fg=${C_MODEL}]%s #[fg=colour8](#[fg=${C_MODEL}]%s#[fg=colour8]) #[fg=colour8]│ #[fg=${C_CTX}]Ctx: %s #[fg=${C_CTX}]%s%%%s" \
        "$short_model" \
        "$EFFORT_DISPLAY" \
        "$CTX_BAR" "$USED_PCT" "$STALE_MARK"

elif [ "$LINE_MODE" = "quota" ]; then
    # Line 1: Quota bars │ $session / $daily
    QUOTA_5H_BAR=$(bar_char "$QUOTA_5H_PCT")
    QUOTA_7D_BAR=$(bar_char "$QUOTA_7D_PCT")

    # Determine quota text color: red on error/expiry, normal otherwise
    QUOTA_COLOR="colour7"
    case "$QUOTA_STATUS" in
        session_key_expired|blocked|error|rate_limited|key_expired|stale) QUOTA_COLOR="colour196" ;;
        *) [ "${KEY_EXPIRY_WARN:-0}" = "1" ] && QUOTA_COLOR="colour196" ;;
    esac

    # Override quota segment colors on error/expiry
    if [ "$QUOTA_COLOR" = "colour196" ]; then
        C_5H="colour196"
        C_7D="colour196"
    fi

    # Format quota pct display: "X" stays as "X", numeric gets "%"
    fmt_quota_pct() {
        if [ "$1" = "X" ]; then echo "X"; else echo "${1}%"; fi
    }
    QUOTA_5H_DISPLAY=$(fmt_quota_pct "$QUOTA_5H_PCT")
    QUOTA_7D_DISPLAY=$(fmt_quota_pct "$QUOTA_7D_PCT")

    COST_SEG="#[fg=colour8]│ #[fg=${C_COST}]\$${SESSION_COST} #[fg=colour8]/ #[fg=${C_COST}]\$${DAILY_COST}"

    if [ "$QUOTA_STATUS" = "no_key" ] || [ "$QUOTA_STATUS" = "none" ]; then
        printf " %s" "$COST_SEG"
    else
        printf " #[fg=${C_5H}]%s: %s #[fg=${C_5H}]%s #[fg=colour8]│ #[fg=${C_7D}]%s: %s #[fg=${C_7D}]%s %s" \
            "$QUOTA_5H_REMAIN" "$QUOTA_5H_BAR" "$QUOTA_5H_DISPLAY" \
            "$QUOTA_7D_REMAIN" "$QUOTA_7D_BAR" "$QUOTA_7D_DISPLAY" \
            "$COST_SEG"
    fi
fi
