#!/usr/bin/env bash
# tmux-status-apply-config — Apply dynamic settings from settings.conf
#
# Reads the user's settings file and applies tmux options that depend
# on configuration values (e.g., clock format). Called by the overlay
# via run-shell at source time.

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/tmux-status"
CONFIG_FILE="${CONFIG_DIR}/settings.conf"

# ── Defaults ───────────────────────────────────────────────────
CLOCK_24H=false
SHOW_TOP_BANNER=true
TOP_BANNER_COLOR=208

# ── Load user settings ─────────────────────────────────────────
# shellcheck source=/dev/null  # user settings file path is dynamic
[ -f "$CONFIG_FILE" ] && . "$CONFIG_FILE"

# ── Sanitize ───────────────────────────────────────────────────
[[ "$TOP_BANNER_COLOR" =~ ^[0-9]+$ ]] || TOP_BANNER_COLOR=208

# ── Apply clock format ─────────────────────────────────────────
if [ "$CLOCK_24H" = "true" ]; then
    tmux set -g status-right '#{?client_prefix,#[fg=colour11][cmd] ,}#[fg=colour4]「#[fg=colour7]%H:%M#[fg=colour4]」'
else
    tmux set -g status-right '#{?client_prefix,#[fg=colour11][cmd] ,}#[fg=colour4]「#[fg=colour7]%-l:%M#[fg=colour4]」'
fi

# ── Apply top banner ──────────────────────────────────────────
# Uses pane-border-status to render a "HOSTNAME · window-name" banner at the top
# of each pane, framed by double-line box-drawing characters (═══╣ ╠═══).
if [ "$SHOW_TOP_BANNER" = "true" ]; then
    # Precompute the hostname ONCE instead of forking `hostname` on every render.
    # A `#(...)` in pane-border-format forks a shell each status-interval tick; under
    # load that fork can fail and tmux then paints the literal
    #   <'hostname -s | tr a-z A-Z' didn't start>
    # across the banner. A static string keeps the banner fork-free (like lines 0-2)
    # and removes that failure mode. The hostname is constant for the tmux server, so
    # recomputing it on each config (re)load is sufficient.
    HOST=$(hostname -s 2>/dev/null | tr 'a-z' 'A-Z')
    HOST=${HOST//[^A-Z0-9._-]/}             # guard: keep only safe hostname chars
    [ -n "$HOST" ] || HOST='#{host_short}'  # fork-free tmux fallback if hostname is empty

    tmux set -g pane-border-status top
    tmux set -g pane-border-lines double
    tmux set -g pane-active-border-style "fg=colour${TOP_BANNER_COLOR}"
    tmux set -g pane-border-style "fg=colour${TOP_BANNER_COLOR}"
    # Hostname is a precomputed static string (fork-free); #{window_name} is a
    # native tmux format (also fork-free) that updates live as the window renames.
    tmux set -g pane-border-format "#[align=centre,bold]╣ ${HOST} · #{window_name} ╠"
else
    tmux set -gu pane-border-status
    tmux set -gu pane-border-lines
    tmux set -gu pane-active-border-style
    tmux set -gu pane-border-style
    tmux set -gu pane-border-format
fi
